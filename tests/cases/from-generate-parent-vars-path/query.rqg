PREFIX ex: <http://ex.org/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX fun: <http://w3id.org/sparql-generate/fn/>
# A dataset per parent solution, queried with a property path
GENERATE {
  GENERATE { ?who ex:reach ?t } FROM GENERATE { ex:n0 ex:next ex:n1 . ex:n1 ex:next ex:n2 . ex:n2 ex:next ?end } . WHERE { ex:n0 ex:next+ ?t } .
} ITERATOR iter:for(1,1,3) AS ?i WHERE { BIND(IRI(CONCAT("http://ex.org/who", STR(?i))) AS ?who) BIND(IRI(CONCAT("http://ex.org/end", STR(?i))) AS ?end) }
