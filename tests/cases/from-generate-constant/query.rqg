PREFIX ex: <http://ex.org/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX fun: <http://w3id.org/sparql-generate/fn/>
# FROM GENERATE: the default graph is the output of a GENERATE sub-query
GENERATE { ?s ex:q ?o }
FROM GENERATE { ?x ex:p ?i } ITERATOR iter:for(1,1,3) AS ?i WHERE { BIND(IRI(CONCAT("http://ex.org/x", STR(?i))) AS ?x) } .
WHERE { ?s ex:p ?o }
