PREFIX ex: <http://ex.org/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX fun: <http://w3id.org/sparql-generate/fn/>
# A sub-GENERATE without dataset clauses queries the dataset of its parent
GENERATE {
  GENERATE { ?s ex:q2 ?o } WHERE { ?s ex:p ?o } .
  ?s ex:q ?o .
}
FROM GENERATE { ex:a ex:p 1 . ex:b ex:p 2 } .
WHERE { ?s ex:p ?o }
