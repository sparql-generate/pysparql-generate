# Two identical parent solutions form one table for the nested GENERATE: LIMIT 3 keeps
# three of the four derived solutions (rule (G)); as a graph the result has two triples.
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX ex: <http://ex.org/>
GENERATE {
  GENERATE { ex:s ex:q ?j } ITERATOR iter:for(1,1,3) AS ?j WHERE {} LIMIT 3 .
} WHERE { VALUES ?i { 1 1 } }
