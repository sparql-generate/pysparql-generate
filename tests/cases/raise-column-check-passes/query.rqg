BASE <http://example.com/>
PREFIX ex: <http://example.com/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>

# The column check of raise-column-check, on columns that the header has; a missing
# document reads no header: no group, no error.
GENERATE {
  GENERATE { } ITERATOR iter:CSVHeaders(<people.csv>) AS ?column_ WHERE { } GROUP BY ?nogroup_ HAVING (true
    && (SUM(IF(STR(?column_) = "name", 1, 0)) > 0 || RAISE("no such column", "name"))
    && (SUM(IF(STR(?column_) = "email", 1, 0)) > 0 || RAISE("no such column", "email"))) .
  GENERATE { } ITERATOR iter:CSVHeaders(<missing.csv>) AS ?column_ WHERE { } GROUP BY ?nogroup_ HAVING (
    SUM(IF(STR(?column_) = "x", 1, 0)) > 0 || RAISE("no such column", "x")) .
  GENERATE { <person/{?name}> ex:email ?email . } ITERATOR iter:CSV(<people.csv>, "name", "email") AS ?name ?email .
}
