PREFIX ex: <http://ex.org/>
PREFIX iter: <http://w3id.org/sparql-generate/iter/>
PREFIX afn: <http://jena.apache.org/ARQ/function#>
# RDF 1.2 triple terms: afn:triple(s, p, o) as subject and object (written <<( s p o )>>),
# nested; triple terms generated by a FROM GENERATE and matched by the WHERE clause (the
# joins of the star maps of rml-star); afn:isTriple, afn:subject, afn:predicate,
# afn:object; STR, as Jena ("<< s p o >>"); a literal subject accepted, a literal
# predicate not
GENERATE {
  ?t ex:q ?z .
  ex:a ex:says ?t2 .
  ?t ex:isTriple ?it ; ex:subject ?su ; ex:predicate ?pr ; ex:object ?ob ; ex:str ?st .
  ?t3 ex:p ex:o .
  ex:b ex:bad ?t4 .
  GENERATE { ?r ex:quoted ?tt . }
  FROM GENERATE {
    GENERATE { ?r ex:qt ?q . ?r ex:qk ?k . }
    ITERATOR iter:CSV(<data1.csv>, "c1", "c2", "c3") AS ?a ?b ?c
    WHERE { BIND(IRI(CONCAT("http://ex.org/r/", ?c)) AS ?r) BIND(afn:triple(IRI(?a), IRI(?b), ?c) AS ?q) BIND(?c AS ?k) } .
  } .
  ITERATOR iter:CSV(<data2.csv>, "k", "z") AS ?k2 ?z2
  WHERE { ?r ex:qk ?k2 . ?r ex:qt ?tt . } .
}
ITERATOR iter:CSV(<data2.csv>, "k", "z") AS ?k ?zs
WHERE {
  BIND(afn:triple(ex:s, ex:p, ?k) AS ?t)
  BIND(IRI(CONCAT("http://ex.org/", ?zs)) AS ?z)
  BIND(afn:triple(ex:s2, ex:p, afn:triple(ex:s, ex:p, CONCAT("x\"", ?k, "\"y"))) AS ?t2)
  BIND(afn:triple(?k, ex:p, 1.5) AS ?t3)
  BIND(afn:triple(ex:s, ?k, ex:o) AS ?t4)
  BIND(afn:isTriple(?t) AS ?it)
  BIND(afn:subject(?t) AS ?su)
  BIND(afn:predicate(?t2) AS ?pr)
  BIND(afn:object(?t2) AS ?ob)
  BIND(STR(?t2) AS ?st)
}
